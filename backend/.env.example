# GitWhistle backend configuration. Copy to .env and fill in. Never commit .env.
# Full reference: ../ENVIRONMENT.md

NODE_ENV=development
PORT=4000
WORKER_HEALTH_PORT=4001
LOG_LEVEL=info

# Public URL of the web app. In local dev the Vite server proxies /api, so API_URL can equal APP_URL.
APP_URL=http://localhost:5173
# Public base URL that GitHub/Slack redirect back to (OAuth callbacks live under /api/v1/...).
API_URL=http://localhost:5173
# Extra allowed browser origins (comma-separated). Defaults to APP_URL.
CORS_ORIGINS=
# Express "trust proxy" setting: loopback (default), a hop count like 1, true, or false.
TRUST_PROXY=loopback
# Force secure cookies on/off. Default: on in production or when APP_URL is https.
COOKIE_SECURE=

DATABASE_URL=postgres://postgres:postgres@localhost:5432/gitwhistle
REDIS_URL=redis://localhost:6379

# 32 random bytes, base64. Encrypts Slack bot tokens at rest. Generate: openssl rand -base64 32
ENCRYPTION_KEY=

SESSION_TTL_HOURS=168
SESSION_IDLE_HOURS=72

# ---- GitHub App (one app provides login, installation, and webhooks) ----
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Either the PEM itself (newlines as \n) or a path to it. Keep the file outside the repository.
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_APP_WEBHOOK_SECRET=

# ---- Slack app ----
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# ---- Operations ----
# Bearer token required by GET /metrics (API and worker). Leave empty to disable /metrics.
METRICS_TOKEN=
WEBHOOK_BODY_LIMIT=25mb
WORKER_EVENT_CONCURRENCY=5
WORKER_DELIVERY_CONCURRENCY=5
EVENT_MAX_ATTEMPTS=8
DELIVERY_MAX_ATTEMPTS=6
WEBHOOK_PAYLOAD_RETENTION_DAYS=14
